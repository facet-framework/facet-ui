{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["jest", "@testing-library/jest-dom", "node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook-facet/**/*.ts",
    ".storybook-facet/**/*.tsx",
    "tsup.config.ts",
    "tsup.standalone.config.ts",
    "jest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
