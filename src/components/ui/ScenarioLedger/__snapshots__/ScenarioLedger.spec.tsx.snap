    style="display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px; padding: 10px 0px; border-top-style: solid; border-top-width: 1px; border-top-color: var(--line); min-width: 0;"
  >
    <span
      style="font-family: var(--font-mono); font-size: var(--text-meta); color: var(--ink); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
    >
      offline-added
