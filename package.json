{
  "name": "@facet-tools/ui",
  "version": "0.1.0-rc.2",
  "description": "FACET UI \u2014 the FACET design system: React components, data layer and custom elements",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-framework/facet-ui.git"
  },
  "homepage": "https://github.com/facet-framework/facet-ui#readme",
  "keywords": [
    "facet",
    "design-system",
    "react",
    "web-components",
    "atlas"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/elements.js",
    "./dist/elements.cjs",
    "./dist/facet-ui.standalone.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./core/fixtures": {
      "import": {
        "types": "./dist/core/fixtures.d.ts",
        "default": "./dist/core/fixtures.js"
      },
      "require": {
        "types": "./dist/core/fixtures.d.cts",
        "default": "./dist/core/fixtures.cjs"
      }
    },
    "./elements": {
      "import": {
        "types": "./dist/elements.d.ts",
        "default": "./dist/elements.js"
      },
      "require": {
        "types": "./dist/elements.d.cts",
        "default": "./dist/elements.cjs"
      }
    },
    "./elements/standalone": "./dist/facet-ui.standalone.js",
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsup && tsup --config tsup.standalone.config.ts && pnpm run licenses:generate",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test:coverage --runInBand",
    "storybook:facet": "storybook dev -p 6007 -c .storybook-facet",
    "build-storybook:facet": "storybook build -c .storybook-facet -o storybook-facet-static",
    "licenses:generate": "node scripts/licenses.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^9.1.20",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^9.1.20",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
